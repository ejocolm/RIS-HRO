# Copia este archivo a .env y completa las credenciales.

# --- API FHIR (facade / router de OpenHIM) ---
FHIR_BASE_URL=https://openhim-qa-router.hro.gob.gt/fhir
# Usuario y contraseña del servidor FHIR / cliente OpenHIM (Basic Auth)
FHIR_USERNAME=
FHIR_PASSWORD=
# Alternativa: header Authorization completo (tiene prioridad), p. ej. "Bearer <token>"
FHIR_AUTH_HEADER=
FHIR_TIMEOUT_SECONDS=10

# --- Sistemas FHIR de los identificadores ---
SYSTEM_HISTORIA_CLINICA=http://hro.gob.gt/historia-clinica
SYSTEM_DPI=http://renap.gob.gt/cui

# --- MLLP / HL7 ---
MLLP_PORT=2575
HL7_CHARSET=UTF-8
HL7_SENDING_APP=HRO_PDQ
HL7_SENDING_FACILITY=HRO
DEFAULT_LIMIT=10
MLLP_TLS=false
