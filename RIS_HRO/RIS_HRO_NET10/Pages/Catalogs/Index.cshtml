@page
@model RIS_HRO.Pages.Catalogs.IndexModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="page-heading">
    <div>
        <h1>@Model.Title</h1>
        <p>@Model.Subtitle</p>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="ris-alert success"><i class="bi bi-check-circle"></i> @success</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="ris-alert error"><i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage</div>
}

<div class="catalog-layout">
    <section class="ris-card">
        <header class="card-heading"><i class="@Model.Icon"></i><h2>@(Model.IsEditing ? "Editar registro" : "Nuevo registro")</h2></header>

        <form method="post">
            <input type="hidden" asp-for="Type" />

            <div class="form-group-ris">
                <label>@Model.IdLabel</label>
                @if (Model.Type == RIS_HRO.Models.CatalogType.Roles)
                {
                    <input asp-for="Edit.Id" readonly placeholder="Se genera automáticamente" />
                }
                else if (Model.IsEditing)
                {
                    <input asp-for="Edit.Id" readonly />
                }
                else
                {
                    <input asp-for="Edit.Id" />
                }
            </div>

            @if (Model.Type == RIS_HRO.Models.CatalogType.Medicos || Model.Type == RIS_HRO.Models.CatalogType.Tecnicos)
            {
                <div class="two-col">
                    <div class="form-group-ris">
                        <label>Nombres</label><input asp-for="Edit.Nombre" />
                    </div>
                    <div class="form-group-ris">
                        <label>Apellidos</label><input asp-for="Edit.Extra1" />
                    </div>
                </div>
            }
            else
            {
                <div class="form-group-ris">
                    <label>@Model.NameLabel</label><input asp-for="Edit.Nombre" />
                </div>
            }

            @if (Model.Type == RIS_HRO.Models.CatalogType.Pruebas)
            {
                <div class="two-col">
                    <div class="form-group-ris">
                        <label>Categoría</label>
                        <select asp-for="Edit.Extra1">
                            <option value="">Seleccione</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.IdCategoria">@c.IdCategoria - @c.NombreCategoria</option>
                            }
                        </select>
                    </div>
                    <div class="form-group-ris">
                        <label>Duración aproximada (minutos)</label>
                        <input asp-for="Edit.Extra2" type="number" min="1" />
                    </div>
                </div>
            }

            @if (Model.Type == RIS_HRO.Models.CatalogType.Medicos)
            {
                <div class="two-col">
                    <div class="form-group-ris"><label>No. colegiado</label><input asp-for="Edit.Extra2" /></div>
                    <div class="form-group-ris"><label>Teléfono</label><input asp-for="Edit.Extra3" /></div>
                </div>
                <div class="form-group-ris"><label>Correo</label><input asp-for="Edit.Extra4" type="email" /></div>
            }

            @if (Model.Type == RIS_HRO.Models.CatalogType.Tecnicos)
            {
                <div class="two-col">
                    <div class="form-group-ris"><label>Teléfono</label><input asp-for="Edit.Extra2" /></div>
                    <div class="form-group-ris"><label>Correo</label><input asp-for="Edit.Extra3" type="email" /></div>
                </div>
            }

            @if (Model.Type != RIS_HRO.Models.CatalogType.Medicos &&
                 Model.Type != RIS_HRO.Models.CatalogType.Tecnicos)
            {
                <div class="form-group-ris">
                    <label>Descripción</label>
                    <textarea asp-for="Edit.Descripcion" rows="3"></textarea>
                </div>
            }

            <div class="check-row">
                <input asp-for="Edit.Activo" />
                <label asp-for="Edit.Activo">Registro activo</label>
            </div>

            <div class="form-bottom-actions">
                <a asp-page="/Catalogs/Index" asp-route-type="@Model.Type" class="btn-ris-cancel">Limpiar</a>
                <button type="submit" class="btn-ris-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            </div>
        </form>
    </section>

    <section class="ris-card">
        <header class="card-heading"><i class="bi bi-list-ul"></i><h2>Registros</h2></header>
        <form method="get" class="search-inline">
            <input type="hidden" name="type" value="@Model.Type" />
            <input name="q" value="@Model.Query" placeholder="Buscar..." />
            <button class="btn-ris-outline" type="submit"><i class="bi bi-search"></i> Buscar</button>
        </form>

        <div class="table-responsive">
            <table class="ris-table">
                <thead>
                    <tr><th>@Model.IdLabel</th><th>@Model.NameLabel</th><th>Detalle</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><strong>@row.Id</strong></td>
                        <td>@row.Nombre @(string.IsNullOrWhiteSpace(row.Extra1) || Model.Type == RIS_HRO.Models.CatalogType.Pruebas ? "" : row.Extra1)</td>
                        <td>@(row.Descripcion ?? row.Extra2 ?? row.Extra3)</td>
                        <td>@(row.Activo ? "Activo" : "Inactivo")</td>
                        <td>
                            <a asp-page="/Catalogs/Index" asp-route-type="@Model.Type" asp-route-edit="@row.Id" class="table-action">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
