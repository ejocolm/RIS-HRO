@page
@model RIS_HRO.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LoginLayout";
}

<div class="login-wrapper">
    <section class="login-hero"
             aria-label="RIS HRO Sistema de Citas de Radiología">
    </section>

    <section class="login-panel-area">
        <div class="login-card">
            <div class="login-icon">
                <img src="~/images/ris-logo.png" alt="RIS HRO" />
            </div>

            <h1>Recuperar contraseña</h1>
            <p class="login-subtitle">
                Ingrese su usuario o correo registrado
            </p>
            <div class="login-accent"></div>

            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="login-info">
                    <i class="bi bi-info-circle"></i>
                    <span>@Model.Message</span>
                </div>
            }

            <form method="post">
                <div class="form-group-ris">
                    <label asp-for="Identifier">
                        Usuario o correo electrónico
                    </label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-person-search"></i>
                        <input asp-for="Identifier"
                               autocomplete="username"
                               placeholder="Usuario o correo registrado" />
                    </div>
                </div>

                <button type="submit"
                        class="btn-ris-primary login-submit">
                    <i class="bi bi-envelope"></i>
                    Enviar nueva contraseña
                </button>
            </form>

            <div style="text-align:center;margin-top:20px">
                <a asp-page="/Account/Login"
                   style="color:#0a56be;text-decoration:none">
                    <i class="bi bi-arrow-left"></i>
                    Volver al inicio de sesión
                </a>
            </div>
        </div>
    </section>
</div>
