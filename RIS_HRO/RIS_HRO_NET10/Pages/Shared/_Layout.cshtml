@using System.Security.Claims
@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool active(string prefix) => page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RIS HRO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-dots"></div>
        <a asp-page="/Dashboard/Index" class="sidebar-brand text-decoration-none">
            <img src="~/images/ris-logo.png" alt="RIS HRO" />
            <div><strong>RIS HRO</strong><span>Sistema de Citas de Radiología</span></div>
        </a>

        <nav class="sidebar-nav">
            <a asp-page="/Dashboard/Index" class="sidebar-link @(active("/Dashboard") ? "active" : "")">
                <i class="bi bi-grid"></i><span>Dashboard</span>
            </a>

            <div class="sidebar-caption">CITAS</div>
            <a asp-page="/Appointments/Create" class="sidebar-link @(page == "/Appointments/Create" ? "active" : "")">
                <i class="bi bi-calendar2-plus"></i><span>Nueva cita</span>
            </a>
            <a asp-page="/Appointments/Index" class="sidebar-link @(active("/Appointments/Index") || active("/Appointments/Edit") ? "active" : "")">
                <i class="bi bi-calendar2-check"></i><span>Consultar citas</span>
            </a>

            <a asp-page="/Patients/Index" class="sidebar-link @(active("/Patients") ? "active" : "")">
                <i class="bi bi-person"></i><span>Pacientes</span>
            </a>

            @if (role == "ADMINISTRADOR")
            {
                <div class="sidebar-caption">CATÁLOGOS</div>
                <a asp-page="/Catalogs/Index" asp-route-type="Medicos" class="sidebar-link">
                    <i class="bi bi-person-badge"></i><span>Médicos</span>
                </a>
                <a asp-page="/Catalogs/Index" asp-route-type="Tecnicos" class="sidebar-link">
                    <i class="bi bi-person-gear"></i><span>Técnicos radiólogos</span>
                </a>
                <a asp-page="/Catalogs/Index" asp-route-type="Servicios" class="sidebar-link">
                    <i class="bi bi-hospital"></i><span>Servicios</span>
                </a>
                <a asp-page="/Catalogs/Index" asp-route-type="Categorias" class="sidebar-link">
                    <i class="bi bi-folder2"></i><span>Categorías</span>
                </a>
                <a asp-page="/Catalogs/Index" asp-route-type="Pruebas" class="sidebar-link">
                    <i class="bi bi-file-earmark-medical"></i><span>Estudios</span>
                </a>
                <a asp-page="/Capacity/Index" class="sidebar-link @(active("/Capacity") ? "active" : "")">
                    <i class="bi bi-speedometer2"></i><span>Capacidad</span>
                </a>

                <div class="sidebar-caption">ADMINISTRACIÓN</div>
                <a asp-page="/Admin/Users" class="sidebar-link @(active("/Admin") ? "active" : "")">
                    <i class="bi bi-people"></i><span>Usuarios</span>
                </a>
                <a asp-page="/Catalogs/Index" asp-route-type="Roles" class="sidebar-link">
                    <i class="bi bi-shield-lock"></i><span>Roles</span>
                </a>

                <a asp-page="/Admin/EmailSettings"
                    class="sidebar-link @(page == "/Admin/EmailSettings" ? "active" : "")">
                <i class="bi bi-envelope-at"></i><span>Configuración correo</span>
                </a>
            }

            <div class="sidebar-caption">REPORTES</div>
            <a asp-page="/Reports/Index" class="sidebar-link @(page == "/Reports/Index" ? "active" : "")">
                <i class="bi bi-bar-chart"></i><span>Reportes</span>
            </a>
            <a asp-page="/Reports/Availability" class="sidebar-link @(page == "/Reports/Availability" ? "active" : "")">
                <i class="bi bi-calendar3"></i><span>Disponibilidad</span>
            </a>
        </nav>

        <form method="post" asp-page="/Account/Logout" class="sidebar-logout">
            <button type="submit"><i class="bi bi-box-arrow-right"></i><span>Cerrar sesión</span></button>
        </form>
    </aside>

    <main class="main-content">
        <header class="top-userbar">
            <div></div>
            <div class="user-chip">
                <span class="user-avatar"><i class="bi bi-person-fill"></i></span>
                <div><small>Usuario</small><strong>@userId</strong></div>
                <i class="bi bi-chevron-down"></i>
            </div>
        </header>

        @RenderBody()
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
