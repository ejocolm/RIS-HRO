@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var isAdmin = User.IsInRole("ADMINISTRADOR");
    var isAppointments = User.IsInRole("USUARIO_CITAS");
    var isReports = User.IsInRole("USUARIO_INFORMES");
    var isWarehouse = User.IsInRole("USUARIO_BODEGA");

    string? manualFile = null;
    var showButton = false;

    if (isAdmin)
    {
        manualFile = "Manual_Administrador.pdf";
        showButton = string.Equals(currentPage, "/Dashboard/Index", StringComparison.OrdinalIgnoreCase);
    }
    else if (isReports)
    {
        manualFile = "Manual_Informes.pdf";
        showButton = string.Equals(currentPage, "/Dashboard/Index", StringComparison.OrdinalIgnoreCase);
    }
    else if (isAppointments)
    {
        manualFile = "Manual_Solicitudes.pdf";
        showButton = string.Equals(currentPage, "/Dashboard/Index", StringComparison.OrdinalIgnoreCase);
    }
    else if (isWarehouse)
    {
        manualFile = "Manual_Bodega.pdf";
        showButton = string.Equals(currentPage, "/Inventory/Index", StringComparison.OrdinalIgnoreCase);
    }
}

@if (showButton && !string.IsNullOrWhiteSpace(manualFile))
{
    <a href="@Url.Content($"~/manuales/{manualFile}")"
       class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-3"
       download
       title="Descargar manual de usuario">
        <i class="bi bi-file-earmark-arrow-down"></i>
        <span class="d-none d-md-inline">Manual de usuario</span>
    </a>
}
