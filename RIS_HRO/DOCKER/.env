# IMPORTANTE:
# Un contenedor Linux no debe usar Trusted_Connection=True como tu ambiente
# de desarrollo actual. Usa un login SQL Server con acceso únicamente a RIS_HRO.
# SQL Server debe aceptar TCP/IP y usar un puerto accesible (normalmente 1433).

ConnectionStrings__DefaultConnection="Server=192.168.1.143\SQLDEV22,1433;Database=RIS_HRO;User Id=sa;Password=Lab2med;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"

# Integración hospitalaria / HL7 (actualmente puede mantenerse deshabilitada).
HospitalPatientService__Enabled=false
HospitalPatientService__Mode=Disabled
HospitalPatientService__BaseUrl=
HospitalPatientService__PatientPath=
HospitalPatientService__PatientIdQueryName=idPaciente
