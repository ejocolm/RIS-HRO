@page
@model RIS_HRO.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Pacientes";
}

<section class="page-heading">
    <div>
        <h1>Pacientes</h1>
        <p>Consulta y mantenimiento de la base local de pacientes</p>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="ris-alert success"><i class="bi bi-check-circle"></i> @success</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="ris-alert error"><i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage</div>
}

<div class="catalog-layout">
    <section class="ris-card">
        <header class="card-heading"><i class="bi bi-person-plus"></i><h2>Datos del paciente</h2></header>
        <form method="post">
            <div class="form-group-ris">
                <label asp-for="Edit.IdPaciente">ID paciente</label>
                @if (Model.IsEditing)
                {
                    <input asp-for="Edit.IdPaciente" readonly />
                }
                else
                {
                    <input asp-for="Edit.IdPaciente" />
                }
            </div>
            <div class="two-col">
                <div class="form-group-ris">
                    <label asp-for="Edit.PrimerNombre">Primer nombre</label>
                    <input asp-for="Edit.PrimerNombre" />
                </div>
                <div class="form-group-ris">
                    <label asp-for="Edit.SegundoNombre">Segundo nombre</label>
                    <input asp-for="Edit.SegundoNombre" />
                </div>
                <div class="form-group-ris">
                    <label asp-for="Edit.PrimerApellido">Primer apellido</label>
                    <input asp-for="Edit.PrimerApellido" />
                </div>
                <div class="form-group-ris">
                    <label asp-for="Edit.SegundoApellido">Segundo apellido</label>
                    <input asp-for="Edit.SegundoApellido" />
                </div>
                <div class="form-group-ris">
                    <label asp-for="Edit.FechaNacimiento">Fecha de nacimiento</label>
                    <input asp-for="Edit.FechaNacimiento" type="date" />
                </div>
                <div class="form-group-ris">
                    <label asp-for="Edit.Sexo">Sexo</label>
                    <select asp-for="Edit.Sexo">
                        <option value="">Seleccione</option>
                        <option value="M">Masculino</option>
                        <option value="F">Femenino</option>
                    </select>
                </div>
            </div>
            <div class="form-group-ris">
                <label asp-for="Edit.Telefono">Teléfono</label>
                <input asp-for="Edit.Telefono" />
            </div>
            <div class="check-row">
                <input asp-for="Edit.Activo" />
                <label asp-for="Edit.Activo">Paciente activo</label>
            </div>
            <div class="form-bottom-actions">
                <a asp-page="/Patients/Index" class="btn-ris-cancel">Limpiar</a>
                <button type="submit" class="btn-ris-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            </div>
        </form>
    </section>

    <section class="ris-card">
        <header class="card-heading"><i class="bi bi-search"></i><h2>Pacientes registrados</h2></header>
        <form method="get" class="search-inline">
            <input name="q" value="@Model.Query" placeholder="Buscar por ID o nombre..." />
            <button class="btn-ris-outline" type="submit"><i class="bi bi-search"></i> Buscar</button>
        </form>
        <div class="table-responsive">
            <table class="ris-table">
                <thead><tr><th>ID</th><th>Paciente</th><th>Teléfono</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                @foreach (var p in Model.Rows)
                {
                    <tr>
                        <td><strong>@p.IdPaciente</strong></td>
                        <td>@p.NombreCompleto</td>
                        <td>@p.Telefono</td>
                        <td>@(p.Activo ? "Activo" : "Inactivo")</td>
                        <td><a asp-page="/Patients/Index" asp-route-edit="@p.IdPaciente" class="table-action"><i class="bi bi-pencil-square"></i></a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
