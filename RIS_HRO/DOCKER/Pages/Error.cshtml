@page
@model RIS_HRO.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}
<section class="page-heading">
    <div>
        <h1>Ocurrió un error</h1>
        <p>No fue posible completar la operación solicitada.</p>
    </div>
</section>
<div class="ris-alert error">
    <i class="bi bi-exclamation-triangle"></i>
    <span>Regrese al módulo anterior e inténtelo nuevamente. Si el problema continúa, revise el registro de la aplicación.</span>
</div>
