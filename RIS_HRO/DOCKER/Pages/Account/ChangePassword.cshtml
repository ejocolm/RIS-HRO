@page
@model RIS_HRO.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<section class="page-heading">
    <div>
        <h1>Cambiar contraseña</h1>
        <p>
            Por seguridad debe sustituir la contraseña temporal
            antes de continuar utilizando RIS HRO.
        </p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="ris-alert error">
        <i class="bi bi-exclamation-triangle"></i>
        @Model.ErrorMessage
    </div>
}

<section class="ris-card"
         style="max-width:620px;margin:30px auto">
    <header class="card-heading">
        <i class="bi bi-shield-lock"></i>
        <h2>Nueva contraseña</h2>
    </header>

    <form method="post">
        <div class="form-group-ris">
            <label asp-for="NewPassword">
                Nueva contraseña
            </label>
            <input asp-for="NewPassword"
                   type="password"
                   minlength="5"
                   autocomplete="new-password" />
        </div>

        <div class="form-group-ris">
            <label asp-for="ConfirmPassword">
                Confirmar contraseña
            </label>
            <input asp-for="ConfirmPassword"
                   type="password"
                   autocomplete="new-password" />
        </div>

        <div class="login-info">
            <i class="bi bi-info-circle"></i>
            <span>
                La contraseña debe contener al menos
                5 caracteres, una letra mayúscula y un número.
            </span>
        </div>

        <button type="submit"
                class="btn-ris-primary"
                style="margin-top:18px;width:100%">
            Guardar nueva contraseña
        </button>
    </form>
</section>
