@page
@model RIS_HRO.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<section class="page-heading">
    <div>
        <h1>Acceso denegado</h1>
        <p>No posee permisos para acceder a esta función.</p>
    </div>
</section>

<section class="ris-card">
    <div class="text-center py-4">
        <i class="bi bi-shield-lock"
           style="font-size:3rem; color:#0b5ea8;"></i>

        <h2 class="mt-3">Acceso restringido</h2>

        <p class="text-muted mb-4">
            Su usuario puede consultar el inventario, pero no tiene permisos
            para abrir el detalle ni realizar acciones adicionales.
        </p>

        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a asp-page="/Inventory/Index" class="btn-ris-primary">
                <i class="bi bi-archive"></i> Volver al inventario
            </a>

            <a asp-page="/Dashboard/Index" class="btn-ris-cancel">
                <i class="bi bi-house"></i> Ir al inicio
            </a>
        </div>
    </div>
</section>
