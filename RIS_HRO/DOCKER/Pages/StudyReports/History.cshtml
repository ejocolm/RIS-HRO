@page
@model RIS_HRO.Pages.StudyReports.HistoryModel
@{
    ViewData["Title"] = "Historial del informe";
}

<section class="page-heading">
    <div>
        <h1>Historial del informe</h1>
        <p>@Model.Current.NumeroCita · @Model.Current.IdPrueba - @Model.Current.NombrePrueba</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="/StudyReports/Edit"
           asp-route-detailId="@Model.Current.IdDetalleCita"
           class="btn-ris-outline">
            <i class="bi bi-file-earmark-medical"></i> Versión vigente
        </a>
        <a asp-page="/Appointments/Edit"
           asp-route-id="@Model.Current.IdCita"
           class="btn-ris-cancel">
            <i class="bi bi-arrow-left"></i> Volver a la cita
        </a>
    </div>
</section>

<div class="ris-alert success">
    <i class="bi bi-shield-check"></i>
    <span>Las versiones anteriores son de solo lectura y no pueden imprimirse ni modificarse.</span>
</div>

<section class="ris-card">
    <header class="card-heading">
        <i class="bi bi-clock-history"></i>
        <div>
            <h2>Versiones anteriores</h2>
            <span>La versión vigente es la @Model.Current.NumeroVersion</span>
        </div>
    </header>

    @if (Model.Versions.Count == 0)
    {
        <div class="text-muted py-4 text-center">
            Todavía no existen versiones históricas para este informe.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="ris-table">
                <thead>
                    <tr>
                        <th>Versión</th>
                        <th>Estado</th>
                        <th>ID interno</th>
                        <th>Fecha del informe</th>
                        <th>Archivada</th>
                        <th>Usuario</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var version in Model.Versions)
                {
                    <tr>
                        <td><strong>Versión @version.NumeroVersion</strong></td>
                        <td><span class="badge text-bg-secondary">@version.Estado</span></td>
                        <td>@(version.IdInternoRadiologia ?? "-")</td>
                        <td>@(version.FechaHoraInforme?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        <td>@version.FechaArchivado.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@version.ArchivadoPor</td>
                        <td>
                            <a asp-page="/StudyReports/HistoryVersion"
                               asp-route-historyId="@version.IdInformeHistorial"
                               class="btn-ris-small">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(version.MotivoArchivado))
                    {
                        <tr>
                            <td></td>
                            <td colspan="6" class="small text-muted">
                                Motivo: @version.MotivoArchivado
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
</section>
